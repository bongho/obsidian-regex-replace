{
	"name": "obsidian-regex-replace",
	"version": "1.1.4",
	"description": "Safely clean up Markdown in Obsidian with regex previews and reusable multi-step pipelines",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "obsidian-plugin", "regex", "replace", "find-replace", "markdown", "productivity"],
	"author": "bongho",
	"license": "0BSD",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
