{
	"name": "obsidian-regex-replace",
	"version": "1.1.7",
	"description": "Safely clean up Markdown in Obsidian with regex previews and reusable multi-step pipelines",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"regex",
		"replace",
		"find-replace",
		"markdown",
		"productivity"
	],
	"author": "bongho",
	"license": "0BSD",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"esbuild": "0.17.3",
		"eslint": "^10.9.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0"
	}
}
